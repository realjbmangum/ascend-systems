<script is:inline>
  (function () {
    document.querySelectorAll('.bs-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var hex = chip.getAttribute('data-hex');
        if (!hex || !navigator.clipboard) return;
        navigator.clipboard.writeText(hex).then(function () {
          var label = chip.querySelector('.bs-chip-copy');
          if (!label) return;
          var prev = label.textContent;
          chip.setAttribute('data-copied', 'true');
          label.textContent = 'copied';
          setTimeout(function () {
            chip.removeAttribute('data-copied');
            label.textContent = prev;
          }, 1400);
        });
      });
    });
  })();
</script>
